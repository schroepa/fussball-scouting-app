---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Dashboard" activeNav="dashboard">
  <div class="space-y-4 md:space-y-6">
    <div class="md:hidden">
      <h1 class="text-2xl font-bold tracking-tight">Dashboard</h1>
      <p class="text-sm text-muted-foreground mt-1">
        Auswerten und vergleichen, am besten am Desktop.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 md:gap-4">
      <a
        href="/dashboard/players"
        class="rounded-xl border border-border bg-card p-5 hover:bg-muted/40 transition-colors"
      >
        <div class="font-semibold text-lg tracking-tight">Spieler</div>
        <p class="text-sm text-muted-foreground mt-1">
          Filtern, Durchschnittsnoten, Vergleich und Verlauf.
        </p>
      </a>
      <a
        href="/dashboard/teams"
        class="rounded-xl border border-border bg-card p-5 hover:bg-muted/40 transition-colors"
      >
        <div class="font-semibold text-lg tracking-tight">Teams</div>
        <p class="text-sm text-muted-foreground mt-1">
          Gegner- und Eigenanalysen nach Verein bündeln.
        </p>
      </a>
    </div>
  </div>
</Layout>
