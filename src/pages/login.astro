---
import Layout from "../layouts/Layout.astro";
import LoginForm from "../components/LoginForm";
---

<Layout title="Anmelden" requireAuth={false} showNav={false}>
  <div class="max-w-md mx-auto pt-6 md:pt-12">
    <div class="text-center mb-6">
      <div class="mx-auto size-12 rounded-xl bg-primary text-primary-foreground grid place-items-center text-sm font-bold tracking-tight">
        FS
      </div>
      <h1 class="text-2xl font-semibold tracking-tight text-card-foreground mt-3">
        Fussball Scouting
      </h1>
      <p class="text-muted-foreground text-sm mt-1">
        Mobil erfassen, am Desktop nachbereiten.
      </p>
    </div>
    <LoginForm client:load />
  </div>
</Layout>
