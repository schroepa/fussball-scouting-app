---
import Layout from "../layouts/Layout.astro";
import LoginForm from "../components/LoginForm";
---

<Layout title="Anmelden" requireAuth={false} showNav={false}>
  <div class="max-w-md mx-auto pt-8 md:pt-16 space-y-6">
    <div class="text-center">
      <div
        class="mx-auto size-11 rounded-xl bg-primary text-primary-foreground grid place-items-center text-xs font-semibold tracking-tight shadow-sm"
        aria-hidden="true"
      >
        FS
      </div>
      <h1 class="text-2xl font-semibold tracking-tight text-foreground mt-4">
        Fusca
      </h1>
      <p class="text-muted-foreground text-sm mt-1.5 max-w-[34ch] mx-auto">
        Anmelden, um Scouting- und Trainerdaten zu synchronisieren.
      </p>
    </div>
    <LoginForm client:load />
  </div>
</Layout>
