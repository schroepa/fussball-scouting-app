---
import Layout from "../layouts/Layout.astro";
import LoginForm from "../components/LoginForm";
---

<Layout title="Anmelden" requireAuth={false} showNav={false}>
  <div class="max-w-sm mx-auto pt-8">
    <div class="text-center mb-6">
      <span class="text-4xl">⚽</span>
      <h1 class="text-2xl font-bold text-card-foreground mt-2 tracking-tight">Anmelden</h1>
      <p class="text-muted-foreground text-sm">
        Melde dich an, um Berichte zu erfassen und zu synchronisieren.
      </p>
    </div>
    <LoginForm client:load />
  </div>
</Layout>
