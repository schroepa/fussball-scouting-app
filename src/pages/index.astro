---
import Layout from "../layouts/Layout.astro";
import {
  ChartColumn,
  CircleHelp,
  ClipboardList,
  Download,
  Users,
  Shield,
} from "lucide-react";
---

<Layout title="Übersicht" activeNav="home">
  <div class="space-y-6 md:space-y-8">
    <section class="md:hidden">
      <h1 class="text-2xl font-bold tracking-tight text-card-foreground mb-1">
        Willkommen zurück
      </h1>
      <p class="text-muted-foreground text-sm">
        Am Platz erfassen – zu Hause am Desktop nachbereiten.
      </p>
    </section>

    <section class="hidden md:block rounded-xl border border-border bg-card p-6">
      <h2 class="text-xl font-semibold tracking-tight">Arbeitsplatz</h2>
      <p class="text-muted-foreground mt-1 max-w-2xl">
        Erfasse Beobachtungen mobil. Am Rechner bearbeitest du Berichte, pflegst
        Spieler und importierst Kader – mit mehr Platz und Übersicht.
      </p>
    </section>

    <section class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-5 gap-3 md:gap-4">
      <a
        href="/dashboard"
        class="rounded-xl border border-border bg-card p-4 md:p-5 flex items-start gap-3 hover:bg-muted/50 transition-colors sm:col-span-2 xl:col-span-1"
      >
        <ChartColumn className="size-6 shrink-0 mt-0.5 text-primary" />
        <div>
          <div class="font-semibold text-base md:text-lg tracking-tight text-card-foreground">
            Dashboard
          </div>
          <div class="text-muted-foreground text-sm mt-1">
            Auswerten, filtern, vergleichen
          </div>
        </div>
      </a>
      <a
        href="/reports/new-player"
        class="group rounded-xl bg-primary text-primary-foreground p-4 md:p-5 flex items-start gap-3 shadow-sm hover:bg-primary/90 transition-colors"
      >
        <Users className="size-6 shrink-0 mt-0.5 opacity-90" />
        <div>
          <div class="font-semibold text-base md:text-lg tracking-tight">
            Spielerbericht
          </div>
          <div class="text-primary-foreground/80 text-sm mt-1">
            Beobachtung mit Bewertungsraster
          </div>
        </div>
      </a>

      <a
        href="/reports/new-team"
        class="group rounded-xl bg-slate-900 text-white p-4 md:p-5 flex items-start gap-3 shadow-sm hover:bg-slate-800 transition-colors"
      >
        <Shield className="size-6 shrink-0 mt-0.5 opacity-90" />
        <div>
          <div class="font-semibold text-base md:text-lg tracking-tight">
            Teambericht
          </div>
          <div class="text-slate-300 text-sm mt-1">
            Gegner-Analyse oder eigenes Team
          </div>
        </div>
      </a>

      <a
        href="/import"
        class="rounded-xl border border-border bg-card p-4 md:p-5 flex items-start gap-3 hover:bg-muted/50 transition-colors"
      >
        <Download className="size-6 shrink-0 mt-0.5 text-primary" />
        <div>
          <div class="font-semibold text-base md:text-lg tracking-tight text-card-foreground">
            Import
          </div>
          <div class="text-muted-foreground text-sm mt-1">
            Transfermarkt, fussball.de, Listen
          </div>
        </div>
      </a>

      <a
        href="/reports"
        class="rounded-xl border border-border bg-card p-4 md:p-5 flex items-start gap-3 hover:bg-muted/50 transition-colors"
      >
        <ClipboardList className="size-6 shrink-0 mt-0.5 text-primary" />
        <div>
          <div class="font-semibold text-base md:text-lg tracking-tight text-card-foreground">
            Berichte
          </div>
          <div class="text-muted-foreground text-sm mt-1">
            Liste durchsuchen und nachbereiten
          </div>
        </div>
      </a>
    </section>

    <section class="grid grid-cols-1 lg:grid-cols-3 gap-4">
      <div class="lg:col-span-2 rounded-xl border border-border bg-card p-4 md:p-5">
        <h3 class="font-semibold tracking-tight mb-2">Tipp für den Desktop</h3>
        <p class="text-sm text-muted-foreground leading-relaxed">
          Nutze die Seitenleiste für schnellen Wechsel zwischen Berichten,
          Spielern und Import. Formulare und Tabellen nutzen auf großen
          Bildschirmen die volle Breite – ideal zum Nachbereiten nach dem Spiel.
        </p>
      </div>
      <div class="rounded-xl border border-border bg-accent/60 p-4 md:p-5">
        <h3 class="font-semibold tracking-tight mb-2 text-accent-foreground">
          Offline mobil
        </h3>
        <p class="text-sm text-foreground/80 leading-relaxed">
          Am Spielfeldrand speichert die App lokal. Sync oben rechts bzw. in der
          Sidebar, sobald wieder Netz da ist.
        </p>
      </div>
    </section>

    <section>
      <a
        href="/hilfe"
        class="flex items-start gap-3 rounded-xl border border-dashed border-border bg-muted/30 p-4 md:p-5 hover:bg-muted/50 transition-colors"
      >
        <CircleHelp className="size-6 shrink-0 mt-0.5 text-primary" />
        <div>
          <div class="font-semibold tracking-tight">Hilfe & Tutorial</div>
          <p class="text-sm text-muted-foreground mt-1">
            Sync, Datenschutz („nur deine Daten“), Import und Desktop –
            nachlesen oder Einführung erneut starten.
          </p>
        </div>
      </a>
    </section>
  </div>
</Layout>
