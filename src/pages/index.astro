---
import Layout from "../layouts/Layout.astro";
import HomeTips from "../components/HomeTips";
import {
  ChartColumn,
  CircleHelp,
  ClipboardList,
  Download,
  SlidersHorizontal,
  Users,
  Shield,
} from "lucide-react";
---

<Layout title="Übersicht" activeNav="home">
  <div id="page-home" class="app-page space-y-6 md:space-y-8">
    <section id="section-welcome" class="app-section md:hidden" aria-labelledby="home-welcome-title">
      <h1 id="home-welcome-title" class="text-2xl font-bold tracking-tight text-card-foreground mb-1">
        Willkommen zurück
      </h1>
      <p class="text-muted-foreground text-sm">
        Am Platz erfassen – zu Hause am Desktop nachbereiten.
      </p>
    </section>

    <section
      id="section-workspace"
      class="app-section hidden md:block rounded-xl border border-border bg-card p-6"
      aria-labelledby="home-workspace-title"
    >
      <h2 id="home-workspace-title" class="text-xl font-semibold tracking-tight">Arbeitsplatz</h2>
      <p class="text-muted-foreground mt-1 max-w-2xl">
        Erfasse Beobachtungen mobil. Am Rechner bearbeitest du Berichte, pflegst
        Spieler und importierst Kader – mit mehr Platz und Übersicht.
      </p>
    </section>

    <section
      id="section-quick-actions"
      class="app-section grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-5 gap-3 md:gap-4"
      aria-label="Schnellzugriff"
    >
      <a
        href="/dashboard"
        class="rounded-xl border border-border bg-card p-4 md:p-5 flex items-start gap-3 hover:bg-muted/50 transition-colors sm:col-span-2 xl:col-span-1"
      >
        <ChartColumn className="size-6 shrink-0 mt-0.5 text-primary" aria-hidden="true" />
        <div>
          <div class="font-semibold text-base md:text-lg tracking-tight text-card-foreground">
            Dashboard
          </div>
          <div class="text-muted-foreground text-sm mt-1">
            Auswerten, filtern, vergleichen
          </div>
        </div>
      </a>
      <a
        href="/reports/new-player"
        class="group rounded-xl bg-primary text-primary-foreground p-4 md:p-5 flex items-start gap-3 shadow-sm hover:bg-primary/90 transition-colors"
      >
        <Users className="size-6 shrink-0 mt-0.5 opacity-90" aria-hidden="true" />
        <div>
          <div class="font-semibold text-base md:text-lg tracking-tight">
            Spielerbericht
          </div>
          <div class="text-primary-foreground/80 text-sm mt-1">
            Beobachtung mit Bewertungsraster
          </div>
        </div>
      </a>

      <a
        href="/reports/new-team"
        class="group rounded-xl bg-foreground text-background p-4 md:p-5 flex items-start gap-3 shadow-sm hover:opacity-90 transition-colors"
      >
        <Shield className="size-6 shrink-0 mt-0.5 opacity-90" aria-hidden="true" />
        <div>
          <div class="font-semibold text-base md:text-lg tracking-tight">
            Teambericht
          </div>
          <div class="text-background/70 text-sm mt-1">
            Gegner-Analyse oder eigenes Team
          </div>
        </div>
      </a>

      <a
        href="/import"
        class="rounded-xl border border-border bg-card p-4 md:p-5 flex items-start gap-3 hover:bg-muted/50 transition-colors"
      >
        <Download className="size-6 shrink-0 mt-0.5 text-primary" aria-hidden="true" />
        <div>
          <div class="font-semibold text-base md:text-lg tracking-tight text-card-foreground">
            Import
          </div>
          <div class="text-muted-foreground text-sm mt-1">
            Transfermarkt, fussball.de, Listen
          </div>
        </div>
      </a>

      <a
        href="/reports"
        class="rounded-xl border border-border bg-card p-4 md:p-5 flex items-start gap-3 hover:bg-muted/50 transition-colors"
      >
        <ClipboardList className="size-6 shrink-0 mt-0.5 text-primary" aria-hidden="true" />
        <div>
          <div class="font-semibold text-base md:text-lg tracking-tight text-card-foreground">
            Berichte
          </div>
          <div class="text-muted-foreground text-sm mt-1">
            Liste durchsuchen und nachbereiten
          </div>
        </div>
      </a>
    </section>

    <HomeTips client:load />

    <section id="section-secondary-links" class="app-section" aria-label="Weitere Einstiege">
      <a
        href="/einstellungen/attribute"
        class="flex items-start gap-3 rounded-xl border border-border bg-card p-4 md:p-5 hover:bg-muted/50 transition-colors mb-3"
      >
        <SlidersHorizontal className="size-6 shrink-0 mt-0.5 text-primary" aria-hidden="true" />
        <div>
          <div class="font-semibold tracking-tight">Bewertungsfelder</div>
          <p class="text-sm text-muted-foreground mt-1">
            Eigene Kategorien zum Standard-Raster ergänzen (z. B. Kopfball).
          </p>
        </div>
      </a>
      <a
        href="/hilfe"
        class="flex items-start gap-3 rounded-xl border border-dashed border-border bg-muted/30 p-4 md:p-5 hover:bg-muted/50 transition-colors"
      >
        <CircleHelp className="size-6 shrink-0 mt-0.5 text-primary" aria-hidden="true" />
        <div>
          <div class="font-semibold tracking-tight">Hilfe & Tutorial</div>
          <p class="text-sm text-muted-foreground mt-1">
            Sync, Datenschutz („nur deine Daten“), Import und Desktop –
            nachlesen oder Einführung erneut starten.
          </p>
        </div>
      </a>
    </section>
  </div>
</Layout>
