---
import Layout from "../../layouts/Layout.astro";
import ImportPanel from "../../components/ImportPanel";
---

<Layout title="Import" activeNav="import">
  <div class="space-y-4 md:space-y-6">
    <div class="md:hidden">
      <h1 class="text-2xl font-bold tracking-tight text-card-foreground mb-1">
        Daten importieren
      </h1>
      <p class="text-sm text-muted-foreground">
        Kader und Vereine übernehmen – mobil oder am Desktop.
      </p>
    </div>

    <div class="hidden md:block rounded-xl border border-border bg-card px-5 py-4">
      <p class="text-sm text-muted-foreground">
        Empfohlen für Jugendkader: Transfermarkt. Am Desktop hast du mehr Platz
        für Trefferlisten und Namenslisten.
      </p>
    </div>

    <div class="md:rounded-xl md:border md:border-border md:bg-card md:p-6">
      <ImportPanel client:load />
    </div>
  </div>
</Layout>
