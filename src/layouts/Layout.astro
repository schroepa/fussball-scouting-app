---
import "../styles/global.css";
import SyncStatusBar from "../components/SyncStatusBar";
import UserMenu from "../components/UserMenu";
import AuthGate from "../components/AuthGate";
import ThemeToggle from "../components/ThemeToggle";
import ThemeSync from "../components/ThemeSync";
import AppNavigation from "../components/AppNavigation";
import MobileHeader from "../components/MobileHeader";
import { CircleHelp, SlidersHorizontal, UserRound } from "lucide-react";
import OnboardingWizard from "../components/OnboardingWizard";

interface Props {
  title?: string;
  activeNav?:
    | "home"
    | "dashboard"
    | "reports"
    | "players"
    | "clubs"
    | "import"
    | "hilfe"
    | "attribute"
    | "kader"
    | "entwicklung"
    | "beobachtungen"
    | "freigaben"
    | "aufstellung"
    | "profil";
  requireAuth?: boolean;
  showNav?: boolean;
}

const {
  title = "Fusca",
  activeNav,
  requireAuth = true,
  showNav = true,
} = Astro.props;

const sidebarExtra = [
  {
    key: "profil",
    href: "/einstellungen/profil",
    label: "Profil & Rollen",
    Icon: UserRound,
  },
  {
    key: "attribute",
    href: "/einstellungen/attribute",
    label: "Bewertungsfelder",
    Icon: SlidersHorizontal,
  },
  { key: "hilfe", href: "/hilfe", label: "Hilfe", Icon: CircleHelp },
] as const;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#eef0f4" />
    <meta name="color-scheme" content="light dark" />
    <meta
      name="description"
      content="Fusca – Scouting und Trainer-Dashboard. Berichte erfassen, Kader führen, Auswertungen nachbereiten."
    />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/icons/icon-192.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} · Fusca</title>
    <script is:inline>
      (function () {
        try {
          var key = "fusca_color_mode";
          var stored = localStorage.getItem(key);
          var preference =
            stored === "light" || stored === "dark" || stored === "system"
              ? stored
              : "system";
          var mode =
            preference === "system"
              ? window.matchMedia("(prefers-color-scheme: dark)").matches
                ? "dark"
                : "light"
              : preference;
          var root = document.documentElement;
          if (mode === "dark") root.classList.add("dark");
          else root.classList.remove("dark");
          root.style.colorScheme = mode;
          root.dataset.theme = mode;
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute("content", mode === "dark" ? "#0b0d12" : "#eef0f4");
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="font-sans antialiased bg-background text-foreground min-h-dvh overflow-x-hidden">
    <a
      href="#app-main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-primary focus:px-3 focus:py-2.5 focus:text-sm focus:font-medium focus:text-primary-foreground focus:outline-none"
    >
      Zum Inhalt springen
    </a>

    <AuthGate client:load requireAuth={requireAuth} />
    <ThemeSync client:load />
    {requireAuth && showNav ? <OnboardingWizard client:load /> : null}

    {
      showNav ? (
        <div id="app-shell" class="min-h-dvh md:flex overflow-x-hidden">
          <aside
            id="app-sidebar"
            class="hidden md:flex md:w-60 md:flex-col md:fixed md:inset-y-0 border-r border-sidebar-border bg-sidebar text-sidebar-foreground"
            aria-label="Hauptnavigation"
          >
            <div class="flex h-14 items-center gap-2.5 px-4 border-b border-sidebar-border">
              <div
                class="size-7 rounded-lg bg-primary text-primary-foreground grid place-items-center text-[10px] font-semibold tracking-tight"
                aria-hidden="true"
              >
                FS
              </div>
              <div class="min-w-0">
                <div class="font-semibold tracking-tight text-sm truncate">Fusca</div>
                <div class="text-[11px] text-muted-foreground truncate">Workspace</div>
              </div>
            </div>
            <nav
              id="nav-sidebar"
              class="flex-1 p-2 space-y-1 flex flex-col min-h-0"
              aria-label="Bereiche"
            >
              <AppNavigation client:load variant="sidebar" activeNav={activeNav} />
              <div class="space-y-0.5 pt-2 border-t border-sidebar-border mt-auto">
                {
                  sidebarExtra.map((item) => {
                    const active = activeNav === item.key;
                    const Icon = item.Icon;
                    return (
                      <a
                        href={item.href}
                        aria-current={active ? "page" : undefined}
                        class:list={[
                          "flex items-center gap-2.5 rounded-md px-2.5 py-2 text-sm font-medium transition-colors focus-ring min-h-10",
                          active
                            ? "bg-sidebar-accent text-sidebar-accent-foreground"
                            : "text-sidebar-foreground/80 hover:bg-sidebar-accent/70 hover:text-sidebar-foreground",
                        ]}
                      >
                        <Icon className="size-4 shrink-0 opacity-70" aria-hidden="true" />
                        {item.label}
                      </a>
                    );
                  })
                }
              </div>
            </nav>
            <div id="app-sidebar-footer" class="border-t border-sidebar-border p-3 space-y-2">
              <div class="rounded-md border border-border/60 bg-background/50 px-2.5 py-2">
                <SyncStatusBar client:load variant="sidebar" />
              </div>
              <div class="flex items-center justify-between gap-2 px-0.5">
                <UserMenu client:load variant="sidebar" />
                <ThemeToggle client:load variant="sidebar" />
              </div>
            </div>
          </aside>

          <div id="app-content-column" class="md:pl-60 flex-1 min-w-0 flex flex-col min-h-dvh overflow-x-hidden">
            <MobileHeader client:load />

            <header
              id="app-header-desktop"
              class="hidden md:flex sticky top-0 z-10 h-14 items-center justify-between border-b border-border bg-background/90 backdrop-blur supports-[backdrop-filter]:bg-background/80 px-6 lg:px-8"
            >
              <div class="min-w-0">
                <h1 class="text-base font-semibold tracking-tight text-foreground truncate">{title}</h1>
              </div>
              <div class="flex items-center gap-2 shrink-0" aria-label="Schnellaktionen">
                <a
                  href="/reports/new-player"
                  class="inline-flex h-9 min-h-9 items-center rounded-md bg-primary px-3 text-sm font-medium text-primary-foreground hover:bg-primary/90 focus-ring"
                >
                  Spielerbericht
                </a>
                <a
                  href="/reports/new-team"
                  class="inline-flex h-9 min-h-9 items-center rounded-md border border-border bg-card px-3 text-sm font-medium text-foreground hover:bg-muted focus-ring"
                >
                  Teambericht
                </a>
              </div>
            </header>

            <main id="app-main" class="flex-1 w-full max-w-6xl mx-auto px-4 py-5 pb-24 md:px-6 md:py-6 lg:px-8 md:pb-8 min-w-0" tabindex="-1">
              <slot />
            </main>

            <nav
              id="nav-mobile"
              class="md:hidden fixed bottom-0 inset-x-0 z-20 border-t border-border bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/90 flex justify-around gap-0 pt-1 pb-[max(0.5rem,env(safe-area-inset-bottom))] min-w-0 overflow-hidden"
              aria-label="Mobile Navigation"
            >
              <AppNavigation client:load variant="mobile" activeNav={activeNav} />
            </nav>
          </div>
        </div>
      ) : (
        <main id="app-main" class="w-full max-w-lg mx-auto px-4 py-8 relative" tabindex="-1">
          <div class="absolute top-4 right-4">
            <ThemeToggle client:load variant="bar" />
          </div>
          <slot />
        </main>
      )
    }

    <script>
      import { registerSW } from "virtual:pwa-register";
      registerSW({
        immediate: true,
        onOfflineReady() {
          console.log("App ist offline-fähig.");
        },
      });
    </script>
  </body>
</html>
