---
import "../styles/global.css";
import SyncStatusBar from "../components/SyncStatusBar";
import UserMenu from "../components/UserMenu";
import AuthGate from "../components/AuthGate";
import ThemeToggle from "../components/ThemeToggle";
import ThemeSync from "../components/ThemeSync";
import AppNavigation from "../components/AppNavigation";
import MobileHeader from "../components/MobileHeader";
import { CircleHelp, SlidersHorizontal, UserRound } from "lucide-react";
import OnboardingWizard from "../components/OnboardingWizard";

interface Props {
  title?: string;
  activeNav?:
    | "home"
    | "dashboard"
    | "reports"
    | "players"
    | "clubs"
    | "import"
    | "hilfe"
    | "attribute"
    | "kader"
    | "entwicklung"
    | "beobachtungen"
    | "freigaben"
    | "aufstellung"
    | "profil";
  requireAuth?: boolean;
  showNav?: boolean;
}

const {
  title = "Fusca",
  activeNav,
  requireAuth = true,
  showNav = true,
} = Astro.props;

const sidebarExtra = [
  {
    key: "profil",
    href: "/einstellungen/profil",
    label: "Profil & Rollen",
    Icon: UserRound,
  },
  {
    key: "attribute",
    href: "/einstellungen/attribute",
    label: "Bewertungsfelder",
    Icon: SlidersHorizontal,
  },
  { key: "hilfe", href: "/hilfe", label: "Hilfe", Icon: CircleHelp },
] as const;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#e8ebf2" />
    <meta name="color-scheme" content="light dark" />
    <meta
      name="description"
      content="Fusca – Scouting und Trainer-Dashboard. Berichte erfassen, Kader führen, Auswertungen nachbereiten."
    />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/icons/icon-192.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} · Fusca</title>
    <script is:inline>
      (function () {
        try {
          var key = "fusca_color_mode";
          var stored = localStorage.getItem(key);
          var preference =
            stored === "light" || stored === "dark" || stored === "system"
              ? stored
              : "system";
          var mode =
            preference === "system"
              ? window.matchMedia("(prefers-color-scheme: dark)").matches
                ? "dark"
                : "light"
              : preference;
          var root = document.documentElement;
          if (mode === "dark") root.classList.add("dark");
          else root.classList.remove("dark");
          root.style.colorScheme = mode;
          root.dataset.theme = mode;
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute("content", mode === "dark" ? "#0b0d14" : "#e8ebf2");
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="font-sans antialiased bg-background text-foreground min-h-dvh overflow-x-hidden">
    <a
      href="#app-main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-xl focus:bg-primary focus:px-3 focus:py-2.5 focus:text-sm focus:font-medium focus:text-primary-foreground focus:outline-none"
    >
      Zum Inhalt springen
    </a>

    <AuthGate client:load requireAuth={requireAuth} />
    <ThemeSync client:load />
    {requireAuth && showNav ? <OnboardingWizard client:load /> : null}

    {
      showNav ? (
        <div
          id="app-shell"
          class="min-h-dvh overflow-x-hidden md:p-3 lg:p-4"
        >
          <div class="md:flex md:gap-3 lg:gap-4 md:min-h-[calc(100dvh-1.5rem)] lg:min-h-[calc(100dvh-2rem)]">
            <aside
              id="app-sidebar"
              class="hidden md:flex md:w-[15.5rem] lg:w-64 md:flex-col md:sticky md:top-3 lg:top-4 md:h-[calc(100dvh-1.5rem)] lg:h-[calc(100dvh-2rem)] panel text-sidebar-foreground bg-sidebar shrink-0"
              aria-label="Hauptnavigation"
            >
              <div class="flex h-16 items-center gap-3 px-4">
                <div
                  class="size-9 rounded-xl bg-primary text-primary-foreground grid place-items-center text-[11px] font-semibold tracking-tight shadow-sm"
                  aria-hidden="true"
                >
                  FS
                </div>
                <div class="min-w-0">
                  <div class="font-semibold tracking-tight text-[15px] truncate">Fusca</div>
                  <div class="text-[11px] text-muted-foreground truncate">Ops workspace</div>
                </div>
              </div>

              <nav
                id="nav-sidebar"
                class="flex-1 px-2.5 pb-2 space-y-1 flex flex-col min-h-0"
                aria-label="Bereiche"
              >
                <AppNavigation client:load variant="sidebar" activeNav={activeNav} />
                <div class="mt-auto pt-3 space-y-0.5">
                  <p class="px-2.5 pb-1 text-[10px] font-medium uppercase tracking-[0.14em] text-muted-foreground">
                    Einstellungen
                  </p>
                  {
                    sidebarExtra.map((item) => {
                      const active = activeNav === item.key;
                      const Icon = item.Icon;
                      return (
                        <a
                          href={item.href}
                          aria-current={active ? "page" : undefined}
                          class:list={[
                            "flex items-center gap-2.5 rounded-xl px-2.5 py-2.5 text-sm font-medium transition-colors focus-ring min-h-11",
                            active
                              ? "bg-sidebar-accent text-sidebar-accent-foreground"
                              : "text-sidebar-foreground/75 hover:bg-muted/70 hover:text-sidebar-foreground",
                          ]}
                        >
                          <Icon className="size-4 shrink-0 opacity-70" aria-hidden="true" strokeWidth={1.75} />
                          {item.label}
                        </a>
                      );
                    })
                  }
                </div>
              </nav>

              <div id="app-sidebar-footer" class="p-3 pt-1 space-y-2">
                <div class="panel-inset px-2.5 py-2">
                  <SyncStatusBar client:load variant="sidebar" />
                </div>
                <div class="flex items-center justify-between gap-2 px-0.5">
                  <UserMenu client:load variant="sidebar" />
                  <ThemeToggle client:load variant="sidebar" />
                </div>
              </div>
            </aside>

            <div id="app-content-column" class="flex-1 min-w-0 flex flex-col min-h-dvh md:min-h-0">
              <MobileHeader client:load />

              <header
                id="app-header-desktop"
                class="hidden md:flex sticky top-3 lg:top-4 z-10 mb-3 lg:mb-4 h-14 items-center justify-between panel px-4 lg:px-5"
              >
                <div class="min-w-0">
                  <h1 class="text-[15px] font-semibold tracking-tight text-foreground truncate">{title}</h1>
                </div>
                <div class="flex items-center gap-2 shrink-0" aria-label="Schnellaktionen">
                  <a
                    href="/reports/new-player"
                    class="inline-flex h-9 min-h-9 items-center rounded-xl bg-primary px-3.5 text-sm font-medium text-primary-foreground hover:bg-primary/90 focus-ring shadow-sm"
                  >
                    Spielerbericht
                  </a>
                  <a
                    href="/reports/new-team"
                    class="inline-flex h-9 min-h-9 items-center rounded-xl border border-border bg-background/60 px-3.5 text-sm font-medium text-foreground hover:bg-muted focus-ring"
                  >
                    Teambericht
                  </a>
                </div>
              </header>

              <main
                id="app-main"
                class="flex-1 w-full max-w-[1400px] mx-auto px-4 py-4 pb-28 md:px-1 md:py-0 md:pb-2 min-w-0"
                tabindex="-1"
              >
                <slot />
              </main>

              <nav
                id="nav-mobile"
                class="md:hidden fixed bottom-3 inset-x-3 z-20 panel flex justify-around gap-0.5 px-1 pt-1.5 pb-[max(0.4rem,env(safe-area-inset-bottom))] min-w-0 overflow-hidden shadow-lg"
                aria-label="Mobile Navigation"
              >
                <AppNavigation client:load variant="mobile" activeNav={activeNav} />
              </nav>
            </div>
          </div>
        </div>
      ) : (
        <main id="app-main" class="w-full max-w-lg mx-auto px-4 py-8 relative" tabindex="-1">
          <div class="absolute top-4 right-4">
            <ThemeToggle client:load variant="bar" />
          </div>
          <slot />
        </main>
      )
    }

    <script>
      import { registerSW } from "virtual:pwa-register";
      registerSW({
        immediate: true,
        onOfflineReady() {
          console.log("App ist offline-fähig.");
        },
      });
    </script>
  </body>
</html>
