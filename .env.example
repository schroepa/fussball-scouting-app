# Supabase-Projekt (kostenloser Free-Tier reicht, siehe README.md).
# Zu finden in: Supabase-Dashboard -> Project Settings -> API
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Nur lokal für Drizzle-Migrationen benötigt (Project Settings -> Database
# -> Connection string -> "Session pooler" oder "Transaction pooler").
# NIEMALS committen / niemals als PUBLIC_-Variable verwenden!
SUPABASE_DB_URL=

# Optional: TheSportsDB (Spieler-/Vereinssuche). Default-Hobby-Key "123".
THESPORTSDB_API_KEY=123

# Optional: api-fussball.de Token für deutsche Amateur-/Jugendvereine + Spiele.
# Token kostenlos unter https://api-fussball.de anlegen (nur serverseitig!).
API_FUSSBALL_TOKEN=

# Optional: SportDB.dev API-Key (https://sportdb.dev) – Proxy auf Transfermarkt.
# Jugendkader funktionieren auch ohne Key über den direkten Transfermarkt-Import.
SPORTDB_API_KEY=

# Shadcn Studio Pro (CLI Registries + MCP) – nie committen.
# E-Mail = Account von shadcnstudio.com (Billing/Account Settings).
EMAIL=
LICENSE_KEY=
# Alias (älterer Name, optional):
SHADCN_STUDIO_LICENSE_KEY=
